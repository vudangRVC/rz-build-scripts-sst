-
diff --git a/meta-rzv2l-vlp4/recipes-kernel/linux/linux-renesas/0008-Add-RZ-remoteproc-driver.patch b/meta-rzv2l-vlp4/recipes-kernel/linux/linux-renesas/0008-Add-RZ-remoteproc-driver.patch
